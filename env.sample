# Copy to ".env" in this folder (same level as package.json), then restart Metro.
# Supabase → Project Settings → API
#
# Client must use the legacy anon JWT (starts with eyJ) for supabase-js — not sb_publishable_*.
# Optional (server/CLI only, never EXPO_PUBLIC_*): SUPABASE_SERVICE_ROLE_KEY

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_jwt_starts_with_eyJ
